<%@ page pageEncoding="UTF-8" %>
<%
    // ── Ruta activa: se deduce de la petición (sin tocar servlets ni rutas) ──
    String _ruta = (String) request.getAttribute("javax.servlet.forward.request_uri");
    if (_ruta == null) {
        _ruta = request.getRequestURI();
    }
    String _activa = "";
    String[] _modulos = {"dashboard", "clientes", "mascotas", "citas", "servicios", "productos", "pedidos"};
    for (int _i = 0; _i < _modulos.length; _i++) {
        if (_ruta != null && _ruta.endsWith("/" + _modulos[_i])) {
            _activa = _modulos[_i];
            break;
        }
    }
    String _usuario = (String) session.getAttribute("nombreUsuario");
    if (_usuario == null) _usuario = "Usuario";
%>
<aside class="app-sidebar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21c-4.5-3-8-6-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 11c0 4-3.5 7-8 10z"/>
            </svg>
        </span>
        <span class="brand-text">
            <span class="brand-name">PetServices</span>
            <span class="brand-sub">Panel de control</span>
        </span>
    </div>

    <nav class="side-nav" aria-label="Navegación principal">
        <ul class="nav-menu">
            <li>
                <a href="<%= request.getContextPath() %>/dashboard" class="nav-link<%= "dashboard".equals(_activa) ? " active" : "" %>"<%= "dashboard".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">01</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/clientes" class="nav-link<%= "clientes".equals(_activa) ? " active" : "" %>"<%= "clientes".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">02</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <span>Clientes</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/mascotas" class="nav-link<%= "mascotas".equals(_activa) ? " active" : "" %>"<%= "mascotas".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">03</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="9" r="1.6"/><circle cx="10.2" cy="5.8" r="1.6"/><circle cx="13.8" cy="5.8" r="1.6"/><circle cx="16.5" cy="9" r="1.6"/><path d="M12 11.2c-2.8 0-5.2 2.3-5.2 5 0 1.6 1.1 2.8 2.6 2.8.9 0 1.6-.5 2.6-.5s1.7.5 2.6.5c1.5 0 2.6-1.2 2.6-2.8 0-2.7-2.4-5-5.2-5z"/></svg>
                    <span>Mascotas</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/citas" class="nav-link<%= "citas".equals(_activa) ? " active" : "" %>"<%= "citas".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">04</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>Citas</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/servicios" class="nav-link<%= "servicios".equals(_activa) ? " active" : "" %>"<%= "servicios".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">05</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    <span>Servicios</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/productos" class="nav-link<%= "productos".equals(_activa) ? " active" : "" %>"<%= "productos".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">06</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <span>Productos</span>
                </a>
            </li>
            <li>
                <a href="<%= request.getContextPath() %>/pedidos" class="nav-link<%= "pedidos".equals(_activa) ? " active" : "" %>"<%= "pedidos".equals(_activa) ? " aria-current=\"page\"" : "" %>>
                    <span class="nav-num" aria-hidden="true">07</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    <span>Pedidos</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-foot">
        <span class="side-user"><%= esc(_usuario) %></span>
        <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <span id="themeToggleText">Modo Oscuro</span>
        </button>
        <a href="<%= request.getContextPath() %>/logout" class="nav-link logout">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Cerrar sesión</span>
        </a>
    </div>
</aside>
