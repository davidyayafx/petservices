<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml — Descriptor de despliegue de PetServices
  ─────────────────────────────────────────────────
  Configura la aplicación web para el servidor Tomcat.
  Los servlets se registran mediante la anotación @WebServlet
  en cada clase (Servlet 3.0+), por lo que no se declaran aquí.

  Proyecto: PetServices - SENA GA7-220501096
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PetServices - GA7-220501096-AA2-EV02</display-name>
    <description>
        Sistema de gestión para tienda de servicios para mascotas.
        Módulos: dashboard, clientes, mascotas, citas, servicios,
        productos y pedidos (CRUD) + API REST en JSON.
    </description>

    <!-- ── Página de bienvenida: redirige al login automáticamente ── -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ── Configuración de sesión: 30 minutos de inactividad ── -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ── Páginas de error personalizadas ── -->
    <error-page>
        <error-code>404</error-code>
        <location>/vistas/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/vistas/error500.jsp</location>
    </error-page>

</web-app>
